to expose returned Maps , use the following :
  @ApiOkResponse({
    schema: {
      type: 'object',
      properties: Object.values(Categories).reduce(
        (acc, step) => {
          acc[step] = { $ref: getSchemaPath(StepsDto) };
          return acc;
        },
        {} as Record<string, any>,
      ),
      required: Object.values(Categories),
    },
  })